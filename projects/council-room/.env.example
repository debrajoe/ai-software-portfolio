# REFERENCE ONLY: portable.py writes private JSON; this file is not automatically loaded.
# Replace placeholders only in a PRIVATE local file, never in source control/cloud sync.
OLYMPUS_OIDC_ISSUER=http://localhost:8080/realms/olympus
OLYMPUS_OIDC_JWKS_URL=http://localhost:8080/realms/olympus/protocol/openid-connect/certs
OLYMPUS_OIDC_AUDIENCE=council-api
OLYMPUS_OIDC_ROLE_CLIENT=council-api
OLYMPUS_OIDC_AUTHORIZED_PARTY=council-local-demo
OLYMPUS_OWNER_SUBJECT=<generated-owner-subject>
OLYMPUS_DATABASE_PATH=<private-local-database>
OLYMPUS_GEMINI_KEY_FILE=<private-local-key-file>
OLYMPUS_CODEX_BINARY=<locally-installed-codex-executable>
OLYMPUS_CODEX_WORKDIR=<private-empty-local-directory>
